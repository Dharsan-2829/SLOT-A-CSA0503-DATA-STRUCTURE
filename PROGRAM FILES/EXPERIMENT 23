#include<stdio.h>

#define INF 999

int main()
{
    int cost[10][10],dist[10],visited[10];
    int n,i,j,start,count,min,next;

    printf("Enter number of vertices: ");
    scanf("%d",&n);

    printf("Enter cost matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&cost[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d",&start);

    for(i=0;i<n;i++)
    {
        dist[i]=cost[start][i];
        visited[i]=0;
    }

    visited[start]=1;
    dist[start]=0;

    for(count=1;count<n;count++)
    {
        min=INF;

        for(i=0;i<n;i++)
        {
            if(dist[i]<min && !visited[i])
            {
                min=dist[i];
                next=i;
            }
        }

        visited[next]=1;

        for(i=0;i<n;i++)
        {
            if(!visited[i] && min+cost[next][i]<dist[i])
                dist[i]=min+cost[next][i];
        }
    }

    printf("Shortest Distances:\n");

    for(i=0;i<n;i++)
        printf("%d -> %d = %d\n",start,i,dist[i]);

    return 0;
}
